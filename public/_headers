# Response headers for static hosts that read this file (Cloudflare Workers and Pages, Netlify).
# Pages carry their own Content-Security-Policy in a <meta> tag, generated at build time.

# Files stay on the visitor's device only as long as the script arrives untouched, so a browser that
# knows the site must not ask for it over plain HTTP. This host only, and not preloaded: a later
# subdomain is not bound by it, and it can be taken back with max-age=0.
#
# The pages' own policy is a <meta> tag, where frame-ancestors is ignored, so this header is what keeps
# another site from showing the converter in a frame as its own. The site frames nothing itself.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Workers take their policy from the script's own response, not from the page that started them,
# so this is what stops the conversion worker from talking to anything but this site.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; img-src 'self' blob: data:

/samples/*
  Cache-Control: public, max-age=86400

/logo.svg
  Cache-Control: public, max-age=86400

/logo-dark.svg
  Cache-Control: public, max-age=86400
