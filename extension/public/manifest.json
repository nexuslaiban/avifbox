{
  "manifest_version": 3,
  "name": "AVIFBox – Save image as PNG or JPG",
  "short_name": "AVIFBox",
  "version": "0.1.0",
  "description": "Right-click an image and save it as PNG or JPG. AVIF, WebP and JFIF are converted on your device, never uploaded.",
  "homepage_url": "https://avifbox.com/",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "downloads", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
