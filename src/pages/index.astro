---
import Base from '../layouts/Base.astro';
import Converter from '../ui/Converter';
import { tools } from '../content/tools';
import { BATCH_FAQ, LIMITS, NAV, PRIVACY_FAQ, RELATED, SITE, STAMPS } from '../content/site';
import { SAMPLE_BUTTONS } from '../content/samples';
import { ORGANIZATION, appSchema, faqSchema } from '../content/schema';
import Cards from '../components/Cards.astro';
import Faq from '../components/Faq.astro';
import type { Faq as FaqEntry, Step } from '../content/types';

const title = 'AVIF Converter — AVIF to PNG or JPG, Free, No Upload | AVIFBox';
const description =
  'Free AVIF converter: turn AVIF, JFIF and WebP images into PNG or JPG in your browser. Batch 50 files, animated and HDR support, nothing uploaded.';
const accept = '.avif,.jfif,.jfi,.jif,.jpg,.jpeg,.webp,.png,image/avif,image/jpeg,image/webp,image/png';

const label = (slug: string) => NAV.converters.find((link) => link.href === `/${slug}`)?.label;

const blurbs: Record<string, string> = {
  'avif-to-png': 'Lossless PNG with transparency. Animated AVIF frame by frame, HDR tone-mapped.',
  'avif-to-jpg': 'Small, universal JPG with a quality slider and a background colour for transparency.',
  'avif-to-apng': 'An animated AVIF as one animated PNG: every frame, its timing and its transparency.',
  'jfif-to-jpg': 'A lossless rename: the .jfif you saved becomes a .jpg, byte for byte.',
  'jfif-to-png': 'JFIF to PNG for editing and for tools that only take PNG.',
  'webp-to-png': 'WebP to PNG with transparency kept; animated WebP split into frames.',
  'webp-to-jpg': 'WebP to JPG for the apps and upload forms that still refuse WebP.',
};

/** What survives each conversion: quality, transparency, animation. */
const keeps: Record<string, [string, string, string]> = {
  'avif-to-png': ['Lossless', 'Kept', 'Every frame, or one animated PNG'],
  'avif-to-jpg': ['Lossy, quality 1–100', 'Filled with a colour you choose', 'One JPG per frame'],
  'avif-to-apng': ['Lossless', 'Kept', 'One animated PNG'],
  'jfif-to-jpg': ['Identical: a rename', 'JPEG has none', 'JPEG has none'],
  'jfif-to-png': ['Lossless', 'JPEG has none', 'JPEG has none'],
  'webp-to-png': ['Lossless', 'Kept', 'Every frame, or one animated PNG'],
  'webp-to-jpg': ['Lossy, quality 1–100', 'Filled with a colour you choose', 'One JPG per frame'],
};

const steps: Step[] = [
  {
    title: 'Add your images',
    body: `Drop AVIF, JFIF or WebP files on the box, press <strong>Choose files</strong>, or paste with Ctrl+V — up to ${LIMITS}. Conversion starts immediately.`,
  },
  {
    title: 'Choose PNG or JPG',
    body: 'PNG keeps every pixel and any transparency. JPG is far smaller and opens in everything. Switch whenever you like: the results and their sizes update as you go.',
  },
  {
    title: 'Download',
    body: 'Save each image, or take the whole batch as one ZIP.',
  },
];

const features = [
  {
    title: 'Converted on your device',
    body: 'Your browser decodes and encodes the images. Nothing is uploaded, so there is no queue and no copy of your image on a server.',
  },
  {
    title: 'Animated AVIF, frame by frame',
    body: 'Every frame of an animated AVIF or WebP is decoded. Keep the frames you want as separate images, or export one animated PNG.',
  },
  {
    title: 'HDR handled on purpose',
    body: 'HDR AVIF is tone-mapped to SDR by the converter itself, with a choice between keeping brightness and keeping colour — not clipped by accident.',
  },
  {
    title: 'Batches without a paywall',
    body: 'Fifty files per batch, fifty megabytes each, download as one ZIP. No account, no watermark, no daily quota.',
  },
];

const faq: FaqEntry[] = [
  {
    question: 'What is an AVIF converter?',
    answer:
      'A tool that saves an AVIF image again in an older format such as PNG or JPG, so that software which cannot read AVIF can open it. The same box turns <a href="/jfif-to-jpg">JFIF into JPG</a> and <a href="/webp-to-jpg">WebP into JPG</a>.',
  },
  {
    question: 'How do I convert an AVIF file to JPG or PNG?',
    answer:
      'Drop the file on the box at the top of this page, choose PNG or JPG, and download the result. There is nothing to install and no account to create.',
  },
  {
    question: 'Should I convert AVIF to PNG or to JPG?',
    answer:
      'PNG for graphics, screenshots, transparency and anything you will edit: it is lossless. JPG for photos you only view or share: the file is far smaller. <a href="/avif-to-png">AVIF to PNG</a> and <a href="/avif-to-jpg">AVIF to JPG</a> go into the details.',
  },
  {
    question: 'Is this AVIF converter free?',
    answer: 'Yes — free, with no sign-up, no watermark and no daily limit.',
  },
  PRIVACY_FAQ,
  BATCH_FAQ,
  {
    question: 'Does it work on a phone?',
    answer:
      'Yes. It runs in the browser on Android, iPhone and iPad just as it does on a computer. A very large image is limited only by the phone’s memory.',
  },
  {
    question: 'Can it convert animated or HDR AVIF?',
    answer:
      'Yes. Every frame of an animated AVIF can be saved as its own image or as one animated PNG, and an HDR AVIF is tone-mapped to SDR, keeping either its brightness or its colour. In Safari only the first frame of an animation is converted.',
  },
  {
    question: 'What is an AVIF file?',
    answer:
      'An image compressed with the AV1 video codec, typically about half the size of a JPG that looks the same. <a href="/what-is-avif">What is AVIF?</a> explains the format, and <a href="/how-to-open-avif-file">how to open an AVIF file</a> covers the programs that read it.',
  },
];

const jsonLd = [
  ORGANIZATION,
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description,
  },
  appSchema({
    name: `${SITE.name} AVIF Converter`,
    path: '/',
    description,
    features: features.map((feature) => feature.title),
  }),
  faqSchema(faq),
];
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="band">
    <div class="wrap reveal">
      <p class="label">
        <span>
          <small>From</small>
          <strong>.AVIF .JFIF .WEBP</strong>
        </span>
        <span>
          <small>To</small>
          <strong>.PNG .JPG</strong>
        </span>
        <span class="label-extra">
          <small>Handling</small>
          <strong>On your device</strong>
        </span>
        <span class="barcode" aria-hidden="true"></span>
      </p>
      <div class="hero-top">
        <div>
          <h1>
            AVIF <em>converter</em>
          </h1>
          <p class="lede">
            Convert AVIF — and JFIF and WebP — to PNG or JPG. The work is done by your own browser, so your images are
            never uploaded.
          </p>
        </div>
      </div>

      <div data-tool>
        <Converter
          client:load
          sourceLabel="AVIF, JFIF or WebP"
          accept={accept}
          target="png"
          chooseTarget
          samples={SAMPLE_BUTTONS}
        />
        <noscript>
          <p class="note">
            The converter needs JavaScript, because your browser does the converting. Nothing is sent to a server.
          </p>
        </noscript>
      </div>

      <ul class="stamps" aria-label="Why AVIFBox">
        {STAMPS.map((stamp) => (
          <li>
            {stamp.title}
            <small>{stamp.note}</small>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <article class="doc wrap">
    <section id="converters">
      <div class="sec-head">
        <span class="sec-no">№ 01</span>
        <h2>Pick a converter</h2>
      </div>
      <ul class="cards">
        {tools.map((tool) => (
          <li>
            <a class="card" href={`/${tool.slug}`}>
              <small>
                {tool.from} → {tool.to}
              </small>
              <strong>{label(tool.slug)}</strong>
              <span>{blurbs[tool.slug]}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="how-to">
      <div class="sec-head">
        <span class="sec-no">№ 02</span>
        <h2>How to convert an AVIF file</h2>
      </div>
      <ol class="steps">
        {steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p set:html={step.body} />
          </li>
        ))}
      </ol>
    </section>

    <section id="why">
      <div class="sec-head">
        <span class="sec-no">№ 03</span>
        <h2>What is in the box</h2>
      </div>
      <ol class="steps">
        {features.map((feature) => (
          <li>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="formats">
      <div class="sec-head">
        <span class="sec-no">№ 04</span>
        <h2>What each conversion keeps</h2>
      </div>
      <div class="slip" tabindex="0" role="region" aria-label="What each conversion keeps">
        <table>
          <caption>Quality, transparency and animation, conversion by conversion</caption>
          <thead>
            <tr>
              <td></td>
              <th scope="col">Quality</th>
              <th scope="col">Transparency</th>
              <th scope="col">Animation</th>
            </tr>
          </thead>
          <tbody>
            {tools.map((tool) => (
              <tr>
                <th scope="row">
                  <a href={`/${tool.slug}`}>{label(tool.slug)}</a>
                </th>
                {keeps[tool.slug].map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <Faq number="№ 05" entries={faq} />

    <Cards
      id="guides"
      number="№ 06"
      title="New to AVIF?"
      links={[RELATED.whatIsAvif, RELATED.openAvif, RELATED.viewer]}
    />
  </article>
</Base>
