---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Cards from '../components/Cards.astro';
import Viewer from '../ui/Viewer';
import { RELATED } from '../content/site';
import { GUIDE_DATES, longDate } from '../content/dates';
import { articleSchema, faqSchema } from '../content/schema';
import { cite } from '../content/sources';
import type { Faq as FaqEntry } from '../content/types';

const path = '/how-to-open-avif-file';
const dates = GUIDE_DATES[path];
const title = 'How to Open an AVIF File (PC, Mac, iPhone, Android) | AVIFBox';
const description =
  'Open an AVIF file on Windows, Mac, iPhone, Android or Linux, in Photoshop or Paint — or view it here in your browser and convert it to PNG or JPG.';

/** The short answer per system: what opens the file, and what to add if it does not. */
const glance: [string, string, string][] = [
  ['Windows 10 and 11', 'Photos, Paint, File Explorer thumbnails', 'The free AV1 Video Extension'],
  ['macOS 13 Ventura or later', 'Preview, Quick Look, Photos, Safari', 'Nothing'],
  ['iPhone and iPad, iOS 16 or later', 'Photos, Files, Safari', 'Nothing'],
  ['Android 12 or later', 'Google Photos, Files, Chrome', 'Nothing'],
  ['Linux', 'Chrome, Firefox', 'Nothing for a browser'],
  ['Photoshop', 'Version 26.8 (June 2025) or later', 'An update, or convert to PNG'],
  ['Any older system', 'A current web browser', 'Or convert to JPG or PNG'],
];

const systems: { id: string; title: string; body: string[] }[] = [
  {
    id: 'windows',
    title: 'On a Windows PC',
    body: [
      `Windows 10 (version 1903 or later) and Windows 11 open AVIF in <strong>Photos</strong>, and show thumbnails in File Explorer, once the free ${cite('av1Extension', '<strong>AV1 Video Extension</strong>')} from the Microsoft Store is installed. Many Windows 11 PCs already have it.`,
      'If Photos says the file format is not supported, install or update that extension and try again.',
    ],
  },
  {
    id: 'paint',
    title: 'In Paint',
    body: [
      'Paint in Windows 11 opens AVIF the same way, through the AV1 Video Extension. The Paint that ships with older versions of Windows cannot read it at all; convert the file to PNG first and it will open without any loss.',
    ],
  },
  {
    id: 'mac',
    title: 'On a Mac',
    body: [
      'From macOS 13 Ventura on, AVIF opens in <strong>Preview</strong>, Quick Look, Photos and Safari with nothing to install. On an older macOS, drag the file into Chrome or Firefox, or convert it.',
    ],
  },
  {
    id: 'iphone',
    title: 'On an iPhone or iPad',
    body: [
      `${cite('safari16', 'iOS 16 and iPadOS 16')} and later show AVIF in <strong>Photos</strong>, Files and Safari. On older versions the picture appears as a blank icon; converting it to JPG is the simplest fix, and it works in Safari on the phone itself.`,
    ],
  },
  {
    id: 'android',
    title: 'On Android',
    body: [
      `${cite('android12', 'Android 12')} and later read AVIF system-wide, so Google Photos, Files and Chrome all display it. On older phones Chrome can usually still open the file even when the gallery cannot.`,
    ],
  },
  {
    id: 'linux',
    title: 'On Linux',
    body: [
      'Chrome and Firefox display AVIF on Linux exactly as they do elsewhere, so dragging the file into a browser window always works. Whether the desktop’s own image viewer opens it depends on the distribution and how recent its image libraries are.',
      `For the command line, ${cite('libavif', 'libavif')} — the reference AVIF library — ships <code>avifdec</code>, which writes a PNG or JPG from an AVIF in one command.`,
    ],
  },
  {
    id: 'photoshop',
    title: 'In Photoshop',
    body: [
      `Photoshop has opened AVIF only since 2025: Adobe lists the format in its ${cite('photoshop', 'June 2025 release, <strong>version 26.8</strong>')}. In earlier versions the file is greyed out in File › Open. Rather than hunting for a plug-in, convert it to PNG: that is lossless, keeps transparency, and every version of Photoshop reads it.`,
      `GIMP reads AVIF from ${cite('gimp', 'version 2.10.22')}.`,
    ],
  },
  {
    id: 'office',
    title: 'In Word, email and upload forms',
    body: [
      'Office suites, email clients, print shops and many website upload forms still refuse AVIF, or accept the file and then show nothing. There is no setting to change on your side: the program at the other end has to read the format.',
      'Convert the image before you insert, attach or upload it. <a href="/avif-to-jpg">AVIF to JPG</a> gives a small file that every form accepts; JPG has no transparency, so use <a href="/avif-to-png">AVIF to PNG</a> for a logo or a cut-out.',
    ],
  },
  {
    id: 'browser',
    title: 'In a web browser',
    body: [
      `The quickest way on any computer: drag the file onto a browser window, or use the viewer at the top of this page. ${cite('caniuseAvif', 'Chrome 85, Firefox 93, Edge 121 and Safari 16')} or later all display AVIF. To keep the viewer at hand, bookmark the <a href="/avif-viewer">AVIF viewer</a> page.`,
    ],
  },
];

const faq: FaqEntry[] = [
  {
    question: 'Why can’t I open an AVIF file?',
    answer:
      'AVIF was published in 2019 and software released before then, or not updated since, does not know the format. Nothing is wrong with the file.',
  },
  {
    question: 'What program opens AVIF files?',
    answer:
      'Any current web browser, Photos on Windows with the AV1 Video Extension, Preview on macOS 13 or later, Photoshop 26.8 or later and GIMP 2.10.22 or later.',
  },
  {
    question: 'How do I open an AVIF file in Windows 10?',
    answer:
      'Install the free AV1 Video Extension from the Microsoft Store, then open the file in Photos. Without it, drag the file into Chrome, Edge or Firefox.',
  },
  {
    question: 'Is it safe to open an AVIF file?',
    answer:
      'An AVIF is an ordinary image, no riskier than a JPG or PNG. Viewing it on this page does not send it anywhere.',
  },
  {
    question: 'Why did a picture I downloaded save as .avif?',
    answer:
      'Websites send AVIF because it is small, and Save image as keeps the file exactly as the website sent it. The picture is fine; only older software cannot read it.',
  },
  {
    question: 'Can I just rename an .avif file to .jpg?',
    answer:
      'No. The name changes but the contents are still AVIF, so a program that cannot read AVIF still fails. Converting writes a real JPG. The one case where a rename works is a .jfif, which is a JPEG already: <a href="/jfif-to-jpg">JFIF to JPG</a> does exactly that.',
  },
  {
    question: 'How do I open an AVIF file on Linux?',
    answer:
      'Drag it into Chrome or Firefox, or use the viewer on this page. On the command line, avifdec from libavif converts it to PNG or JPG.',
  },
  {
    question: 'How do I turn an AVIF into a JPG or PNG?',
    answer:
      'Use <a href="/avif-to-jpg">AVIF to JPG</a> for a small file that opens everywhere, or <a href="/avif-to-png">AVIF to PNG</a> for a lossless copy that keeps transparency.',
  },
  {
    question: 'Does converting an AVIF lose quality?',
    answer:
      'Converting to PNG loses nothing: every pixel is kept as decoded. JPG compresses again, but at the default quality the difference is hard to see, and the file opens everywhere.',
  },
];

const jsonLd = [articleSchema({ path, headline: 'How to open an AVIF file', description, ...dates }), faqSchema(faq)];
---

<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="band">
    <div class="wrap reveal">
      <p class="label">
        <span>
          <small>Guide</small>
          <strong>How to</strong>
        </span>
        <span>
          <small>Subject</small>
          <strong>.AVIF</strong>
        </span>
        <span class="barcode" aria-hidden="true"></span>
      </p>
      <h1>
        How to open an <em>AVIF</em> file
      </h1>
      <p class="lede">
        Drop the file below to view it straight away — your browser can almost certainly display it. Then find your
        system for a permanent fix, or convert the image to a format everything opens.
      </p>
      <p class="dateline">
        Updated <time datetime={dates.updated}>{longDate(dates.updated)}</time>
      </p>
      <div data-tool class="tool-gap">
        <Viewer client:load />
        <noscript>
          <p class="note">The viewer needs JavaScript. The instructions below work without it.</p>
        </noscript>
      </div>
    </div>
  </section>

  <article class="doc wrap">
    <section id="at-a-glance">
      <div class="sec-head">
        <span class="sec-no">№ 01</span>
        <h2>The short answer, system by system</h2>
      </div>
      <div class="slip" tabindex="0" role="region" aria-label="What opens an AVIF file">
        <table>
          <caption>What opens an AVIF file, and what to add if it does not</caption>
          <thead>
            <tr>
              <td></td>
              <th scope="col">Opens AVIF in</th>
              <th scope="col">What to install</th>
            </tr>
          </thead>
          <tbody>
            {glance.map(([system, opens, install]) => (
              <tr>
                <th scope="row">{system}</th>
                <td>{opens}</td>
                <td>{install}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="split">
      {systems.map((system, index) => (
        <section id={system.id}>
          <div class="sec-head">
            <span class="sec-no">№ {String(index + 2).padStart(2, '0')}</span>
            <h2>{system.title}</h2>
          </div>
          <div class="prose">
            {system.body.map((paragraph) => (
              <p set:html={paragraph} />
            ))}
          </div>
        </section>
      ))}
      <section id="convert">
        <div class="sec-head">
          <span class="sec-no">№ {String(systems.length + 2).padStart(2, '0')}</span>
          <h2>When nothing works: convert it</h2>
        </div>
        <div class="prose">
          <p>
            Converting sidesteps the whole question. <a href="/avif-to-jpg">AVIF to JPG</a> makes a small file that
            every phone, program and upload form accepts. <a href="/avif-to-png">AVIF to PNG</a> makes a lossless copy
            and keeps transparency, animation frames included.
          </p>
          <p>
            Pictures saved from the web also arrive as .webp or .jfif. <a href="/webp-to-jpg">WebP to JPG</a> and{' '}
            <a href="/jfif-to-jpg">JFIF to JPG</a> deal with those the same way.
          </p>
          <p>
            All of them run in your browser and never upload the image. To understand the format itself, read{' '}
            <a href="/what-is-avif">what AVIF is</a>.
          </p>
        </div>
      </section>
    </section>

    <Faq number={`№ ${String(systems.length + 3).padStart(2, '0')}`} entries={faq} />
    <Cards
      id="related"
      number={`№ ${String(systems.length + 4).padStart(2, '0')}`}
      title="More from the box"
      links={[RELATED.avifToJpg, RELATED.avifToPng, RELATED.viewer, RELATED.whatIsAvif]}
    />
  </article>
</Base>
