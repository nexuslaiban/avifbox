---
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/atkinson-hyperlegible-next';
import '@fontsource-variable/atkinson-hyperlegible-mono';
import '../styles/global.css';
import { NAV, SITE } from '../content/site';

interface Props {
  title: string;
  description: string;
  /** Site-relative path of the page, e.g. `/avif-to-png`. */
  path: string;
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description, path, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const current = (href: string) => (href === path ? 'page' : undefined);
const holds = (links: readonly { href: string }[]) => links.some((link) => link.href === path);
const formats = [...new Set(NAV.converters.map((link) => link.group))];
/** Header menus: a button, and under it one list of links per group. */
const menus = [
  {
    label: 'Converters',
    groups: formats.map((title) => ({ title, links: NAV.converters.filter((link) => link.group === title) })),
  },
  { label: 'Guides', groups: [{ title: undefined, links: NAV.guides }] },
];
const footerGroups = [
  ['Converters', NAV.converters],
  ['Guides', NAV.guides],
  ['About', NAV.about],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#d8c49c" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#241d13" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <div class="tape" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path
              d="M3 10.5 16 4l13 6.5v11L16 28 3 21.5z"
              fill="var(--accent)"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linejoin="round"
            ></path>
            <path
              d="M3 10.5 16 17l13-6.5M16 17v11"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linejoin="round"
            ></path>
          </svg>
          <span>
            AVIF<b>Box</b>
          </span>
        </a>
        <nav class="site-nav" aria-label="Converters and guides">
          <ul>
            {menus.map((item) => (
              <li>
                <details
                  name="site-menu"
                  data-current={item.groups.some((group) => holds(group.links)) ? '' : undefined}
                >
                  <summary>{item.label}</summary>
                  <div class="menu">
                    {item.groups.map(({ title, links }) => (
                      <div>
                        {title && <p id={`menu-${title.toLowerCase()}`}>{title}</p>}
                        <ul aria-labelledby={title && `menu-${title.toLowerCase()}`}>
                          {links.map((link) => (
                            <li>
                              <a href={link.href} aria-current={current(link.href)}>
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <h2>{SITE.name}</h2>
          <p>{SITE.tagline}. Your files are converted on your own device and are never uploaded.</p>
        </div>
        {footerGroups.map(([heading, links]) => (
          <nav aria-label={heading}>
            <h2>{heading}</h2>
            <ul>
              {links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
        <p class="fine">
          No cookies, no tracking, no ads. AVIF decoding for HDR images uses libavif, © Alliance for Open Media and
          jSquash contributors.
        </p>
      </div>
    </footer>
    <script>
      // The menus open, close and exclude each other without this. It adds Escape and a click elsewhere.
      const menus = [...document.querySelectorAll<HTMLDetailsElement>('.site-nav details')];
      document.addEventListener('click', (event) => {
        for (const menu of menus) if (!menu.contains(event.target as Node)) menu.open = false;
      });
      document.addEventListener('keydown', (event) => {
        const open = event.key === 'Escape' ? menus.find((menu) => menu.open) : undefined;
        if (!open) return;
        open.open = false;
        open.querySelector('summary')?.focus();
      });
    </script>
  </body>
</html>
