---
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/atkinson-hyperlegible-next';
import '@fontsource-variable/atkinson-hyperlegible-mono';
import '../styles/global.css';
import Menu from '../components/Menu.astro';
import { NAV, SITE } from '../content/site';

interface Props {
  title: string;
  description: string;
  /** Site-relative path of the page, e.g. `/avif-to-png`. */
  path: string;
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description, path, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const formats = [...new Set(NAV.converters.map((link) => link.group))];
/** The Converters menu lists them under their source format. */
const byFormat = formats.map((title) => ({ title, links: NAV.converters.filter((link) => link.group === title) }));
const footerGroups = [
  ['Converters', NAV.converters],
  ['Guides', [...NAV.guides, NAV.viewer]],
  ['About', NAV.about],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#d8c49c" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#241d13" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <div class="tape" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}>
          {/* A file with a fixed address, not inline SVG: other sites and crawlers can fetch it. */}
          <picture>
            <source srcset="/logo-dark.svg" media="(prefers-color-scheme: dark)" />
            <img src="/logo.svg" alt={SITE.name} width="32" height="32" />
          </picture>
          <span>
            AVIF<b>Box</b>
          </span>
        </a>
        <nav class="site-nav" aria-label="Converters, viewer and guides">
          <ul>
            <li>
              <Menu label="Converters" groups={byFormat} path={path} />
            </li>
            <li>
              <a href={NAV.viewer.href} aria-current={NAV.viewer.href === path ? 'page' : undefined}>
                {NAV.viewer.label}
              </a>
            </li>
            <li>
              <Menu label="Guides" groups={[{ links: NAV.guides }]} path={path} />
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <h2>{SITE.name}</h2>
          <p>{SITE.tagline}. Your files are converted on your own device and are never uploaded.</p>
        </div>
        {footerGroups.map(([heading, links]) => (
          <nav aria-label={heading}>
            <h2>{heading}</h2>
            <ul>
              {links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
        <p class="fine">
          No cookies, no tracking, no ads. AVIF decoding for HDR images uses libavif, © Alliance for Open Media and
          jSquash contributors.
        </p>
      </div>
    </footer>
    <script>
      // The menus open, close and exclude each other without this. It adds Escape and a click elsewhere.
      const menus = [...document.querySelectorAll<HTMLDetailsElement>('.site-nav details')];
      document.addEventListener('click', (event) => {
        for (const menu of menus) if (!menu.contains(event.target as Node)) menu.open = false;
      });
      document.addEventListener('keydown', (event) => {
        const open = event.key === 'Escape' ? menus.find((menu) => menu.open) : undefined;
        if (!open) return;
        open.open = false;
        open.querySelector('summary')?.focus();
      });
    </script>
  </body>
</html>
